{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "target": "ES2021"
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/*"]
}
